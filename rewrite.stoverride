name: 个人去广告、DNS 与 MitM 覆写
desc: 个人 Stash DNS（含 STUN 放行）、MitM 重写与去广告规则

dns:
  enable: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fake-ip-filter:
    - '*.lan'
    - 'geosite:private'
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'

http:
  mitm:
    - "api.hellobike.com"

  url-rewrite:
    # 哈啰（App / 支付宝小程序）：自家广告平台的广告下发与曝光回传（开屏等广告位）
    - '^https://api\.hellobike\.com/api\?adx\.ssp\.(show|callback) - reject-dict'

rules:
  # 哈啰 App 内置的第三方广告 SDK：Sigmob（穿山甲、广点通已由通用广告规则拦截）
  - DOMAIN-SUFFIX,sigmob.cn,REJECT
